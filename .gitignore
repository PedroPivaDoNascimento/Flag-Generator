# =============================================================================
# .gitignore - Copa 2026 Flag Generator
# Python + Colab + Desenvolvimento Local
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 🐍 Python / Bytecode / Cache
# ─────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.pytest_cache/
.hypothesis/

# ─────────────────────────────────────────────────────────────────────────────
# 🌐 Ambientes Virtuais / Dependências
# ─────────────────────────────────────────────────────────────────────────────
# Virtual environments
venv/
env/
.venv/
env.bak/
venv.bak/
.venv-backup/

# Virtualenv clone
.env/
.ENV/

# Pipenv
.pipenv/
Pipfile.lock

# Poetry
.poetry/

# ─────────────────────────────────────────────────────────────────────────────
# 📊 Dados e Arquivos de Saída (NÃO versionar dados sensíveis ou gerados)
# ─────────────────────────────────────────────────────────────────────────────
# Arquivos de entrada do usuário (cada um tem seu próprio arquivo)
*.xlsx
*.xls
*.csv

# PDFs gerados
*.pdf

# Imagens temporárias do processamento
temp_*.png
temp_*.jpg
temp_*.jpeg

# Logs de execução (exceto .gitkeep para manter a pasta)
*.log
logs/
!logs/.gitkeep

# Arquivos de configuração local (com dados sensíveis)
config/local.json
config/secrets.json
*.local.json

# ─────────────────────────────────────────────────────────────────────────────
# 🔐 Secrets / Credenciais / Ambiente
# ─────────────────────────────────────────────────────────────────────────────
# Environment variables (NUNCA commitar credenciais)
.env
.env.local
.env.*.local
*.env

# Chaves de API, tokens, senhas
secrets/
credentials.json
service_account.json
*.pem
*.key

# ─────────────────────────────────────────────────────────────────────────────
# 🧪 Testes / Desenvolvimento
# ─────────────────────────────────────────────────────────────────────────────
# Test coverage
.coverage
.coverage.*
htmlcov/

# IDEs e Editores
.idea/
.vscode/
*.swp
*.swo
*.swn
*~
.project
.settings/
*.sublime-project
*.sublime-workspace

# Jupyter / Colab
.ipynb_checkpoints/
*.ipynb
*.ipynb_checkpoints
colab-notebooks/

# ─────────────────────────────────────────────────────────────────────────────
# 📦 Build / Distribuição / Empacotamento
# ─────────────────────────────────────────────────────────────────────────────
# Python build artifacts
build/
dist/
*.egg-info/
eggs/
wheels/
*.egg

# PyInstaller
*.manifest
*.spec

# ─────────────────────────────────────────────────────────────────────────────
# 🗂️ Sistema Operacional / Misc
# ─────────────────────────────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.Trash-*
.nfs*

# ─────────────────────────────────────────────────────────────────────────────
# ✅ O QUE DEVEMOS VERSIONAR (para referência)
# ─────────────────────────────────────────────────────────────────────────────
# ✅ versionar:
#   • requirements.txt
#   • config/country_codes.json (template, sem dados reais)
#   • src/ (todo o código fonte)
#   • tests/ (testes unitários)
#   • README.md, LICENSE, .gitignore
#   • utils/logging_config.py
#
# ❌ NÃO versionar:
#   • Dados de entrada (.xlsx, .csv)
#   • Arquivos de saída (.pdf, imagens temporárias)
#   • Credenciais (.env, secrets)
#   • Ambientes virtuais (venv/)
#   • Cache (__pycache__/, *.pyc)
# ─────────────────────────────────────────────────────────────────────────────